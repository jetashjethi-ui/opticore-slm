{
    "name": "opticore-slm",
    "displayName": "OptiCore SLM",
    "description": "The Sovereign C++ Performance Auditor — Analyze and optimize C++ code locally using AI.",
    "version": "0.1.0",
    "publisher": "opticore-team",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:cpp",
        "onLanguage:c"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "opticore.optimizeSelection",
                "title": "OptiCore: Optimize Selection"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "editorHasSelection && resourceLangId == cpp",
                    "command": "opticore.optimizeSelection",
                    "group": "1_modification"
                },
                {
                    "when": "editorHasSelection && resourceLangId == c",
                    "command": "opticore.optimizeSelection",
                    "group": "1_modification"
                }
            ]
        },
        "configuration": {
            "title": "OptiCore SLM",
            "properties": {
                "opticore.serverUrl": {
                    "type": "string",
                    "default": "http://127.0.0.1:8080",
                    "description": "URL of the OptiCore Python server."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "^20.0.0",
        "typescript": "^5.3.0"
    }
}